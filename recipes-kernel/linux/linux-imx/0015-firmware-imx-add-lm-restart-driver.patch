diff --git a/drivers/firmware/imx/imx-lm-restart.c b/drivers/firmware/imx/imx-lm-restart.c
new file mode 100644
index 000000000000..3347d5d09029
--- /dev/null
+++ b/drivers/firmware/imx/imx-lm-restart.c
@@ -0,0 +1,136 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Restart another Logical Machine through the i.MX System Manager
+ *
+ * Copyright 2026 Auterion
+ */
+
+#include <linux/device.h>
+#include <linux/firmware/imx/sm.h>
+#include <linux/kstrtox.h>
+#include <linux/mod_devicetable.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/platform_device.h>
+#include <linux/property.h>
+#include <linux/scmi_imx_protocol.h>
+
+struct imx_lm_restart {
+	struct device *dev;
+	struct mutex lock; /* one reset request at a time */
+	u32 lmid;
+};
+
+static ssize_t restart_store(struct device *dev, struct device_attribute *attr,
+			     const char *buf, size_t count)
+{
+	struct imx_lm_restart *priv = dev_get_drvdata(dev);
+	bool restart;
+	int ret;
+
+	ret = kstrtobool(buf, &restart);
+	if (ret)
+		return ret;
+
+	if (!restart)
+		return count;
+
+	mutex_lock(&priv->lock);
+	dev_info(dev, "resetting LM%u\n", priv->lmid);
+	ret = scmi_imx_lmm_operation(priv->lmid, SCMI_IMX_LMM_RESET,
+				     SCMI_IMX_LMM_OP_FORCEFUL);
+	mutex_unlock(&priv->lock);
+
+	if (ret == -EACCES)
+		dev_err(dev, "SM denied reset of LM%u, needs LMM_%u ALL in the SM config\n",
+			priv->lmid, priv->lmid);
+	else if (ret)
+		dev_err(dev, "reset of LM%u failed: %d\n", priv->lmid, ret);
+
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_WO(restart);
+
+static const char * const imx_lm_state_names[] = {
+	[LMM_STATE_LM_OFF] = "off",
+	[LMM_STATE_LM_ON] = "on",
+	[LMM_STATE_LM_SUSPEND] = "suspended",
+	[LMM_STATE_LM_POWERED] = "powered",
+};
+
+static ssize_t state_show(struct device *dev, struct device_attribute *attr,
+			  char *buf)
+{
+	struct imx_lm_restart *priv = dev_get_drvdata(dev);
+	struct scmi_imx_lmm_info info = { };
+	int ret;
+
+	ret = scmi_imx_lmm_info(priv->lmid, &info);
+	if (ret)
+		return ret;
+
+	if (info.state >= ARRAY_SIZE(imx_lm_state_names))
+		return sysfs_emit(buf, "unknown (%u)\n", info.state);
+
+	return sysfs_emit(buf, "%s\n", imx_lm_state_names[info.state]);
+}
+static DEVICE_ATTR_RO(state);
+
+static struct attribute *imx_lm_restart_attrs[] = {
+	&dev_attr_restart.attr,
+	&dev_attr_state.attr,
+	NULL
+};
+ATTRIBUTE_GROUPS(imx_lm_restart);
+
+static int imx_lm_restart_probe(struct platform_device *pdev)
+{
+	struct device *dev = &pdev->dev;
+	struct scmi_imx_lmm_info info = { };
+	struct imx_lm_restart *priv;
+	int ret;
+
+	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
+	if (!priv)
+		return -ENOMEM;
+
+	ret = device_property_read_u32(dev, "fsl,lmm-id", &priv->lmid);
+	if (ret)
+		return dev_err_probe(dev, ret, "missing fsl,lmm-id\n");
+
+	/* Defers until the SCMI LMM driver is up, and checks the LM exists */
+	ret = scmi_imx_lmm_info(priv->lmid, &info);
+	if (ret)
+		return dev_err_probe(dev, ret, "LM%u not available\n", priv->lmid);
+
+	priv->dev = dev;
+	ret = devm_mutex_init(dev, &priv->lock);
+	if (ret)
+		return ret;
+
+	platform_set_drvdata(pdev, priv);
+
+	dev_info(dev, "controls LM%u (%s)\n", priv->lmid, info.name);
+
+	return 0;
+}
+
+static const struct of_device_id imx_lm_restart_of_match[] = {
+	{ .compatible = "auterion,imx-lm-restart" },
+	{ }
+};
+MODULE_DEVICE_TABLE(of, imx_lm_restart_of_match);
+
+static struct platform_driver imx_lm_restart_driver = {
+	.probe = imx_lm_restart_probe,
+	.driver = {
+		.name = "imx-lm-restart",
+		.of_match_table = imx_lm_restart_of_match,
+		.dev_groups = imx_lm_restart_groups,
+	},
+};
+module_platform_driver(imx_lm_restart_driver);
+
+MODULE_AUTHOR("Philipp Engljaehringer <philipp.engljahringer@auterion.com>");
+MODULE_DESCRIPTION("i.MX SM Logical Machine restart driver");
+MODULE_LICENSE("GPL");
