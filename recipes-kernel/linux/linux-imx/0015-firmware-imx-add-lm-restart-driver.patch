@@ -45,6 +45,18 @@ config IMX_SCMI_LMM_DRV
 
 	  This driver can also be built as a module.
 
+config IMX_SCMI_LM_RESTART
+	tristate "IMX SCMI Logical Machine restart driver"
+	depends on IMX_SCMI_LMM_DRV
+	help
+	  Exposes a sysfs "restart" attribute that asks the System Manager to
+	  reset another Logical Machine, e.g. the Cortex-M7 on i.MX95. The LM
+	  boots again from its configured reset vector, no firmware is loaded
+	  by Linux. The Linux agent needs LMM permission for the target LM in
+	  the System Manager configuration.
+
+	  This driver can also be built as a module.
+
