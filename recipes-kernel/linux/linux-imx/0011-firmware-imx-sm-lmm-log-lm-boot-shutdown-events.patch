+/* See LMM_EVENT in imx95.rst */
+#define SCMI_IMX_LMM_EVENT_BOOT		BIT(0)
+#define SCMI_IMX_LMM_EVENT_SHUTDOWN	BIT(1)
+#define SCMI_IMX_LMM_EVENT_SUSPEND	BIT(2)
+#define SCMI_IMX_LMM_EVENT_WAKE		BIT(3)
